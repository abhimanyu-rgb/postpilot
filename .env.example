# LinkedIn OAuth (from LinkedIn Developer Portal > Your App > Auth tab)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/linkedin/callback
# These are auto-populated after OAuth flow — do NOT edit manually
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_PERSON_URN=

# LLM (required)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# News Source (optional — falls back to free RSS/Reddit/HN if not set)
NEWS_API_KEY=

# App
DATABASE_URL=sqlite:///data/app.db
# Posting / scheduling timezone. Common values: Asia/Kolkata, America/New_York,
# America/Los_Angeles, Europe/London, UTC
TIMEZONE=Asia/Kolkata
DAILY_POST_BUDGET=1
MIN_GAP_MINUTES=180

# Logging verbosity. DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
